# Terraform generates ansible/inventory.ini automatically (terraform apply).
# This is what it looks like:
[webservers]
week6-server ansible_host=127.0.0.1 ansible_port=2222 ansible_user=ansible ansible_ssh_private_key_file=/full/path/to/ansible/.ssh/id_ed25519

[all:vars]
ansible_python_interpreter=/usr/bin/python3

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Terraform + Ansible</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f6f8; margin: 0; }
    header { background: #1f3a5f; color: #fff; padding: 28px; text-align: center; }
    .card { max-width: 560px; margin: 30px auto; background: #fff; padding: 24px; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.1); }
  </style>
</head>
<body>
  <header><h1>Terraform &rarr; Infrastructure &rarr; Ansible &rarr; Application</h1></header>
  <div class="card">
    <h2>{{ welcome_message }}</h2>
    <p>Host: <b>{{ inventory_hostname }}</b></p>
    <p>Application user: <b>{{ app_user }}</b></p>
    <p>OS: <b>{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</b></p>
  </div>
</body>
</html>

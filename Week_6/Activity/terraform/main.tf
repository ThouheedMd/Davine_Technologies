# Activity: Terraform provisions the infrastructure (a Docker-based server).
# Ansible then configures it (see ../ansible).

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "docker" {
  host = var.docker_host
}

# SSH key pair generated by Terraform for Ansible to use
resource "tls_private_key" "ssh" {
  algorithm = "ED25519"
}

resource "local_sensitive_file" "private_key" {
  content         = tls_private_key.ssh.private_key_openssh
  filename        = "${path.module}/../ansible/.ssh/id_ed25519"
  file_permission = "0600"
}

# Image for the server, built from ./docker
resource "docker_image" "server" {
  name = "${var.server_name}:latest"

  build {
    context = "${path.module}/docker"
    tag     = ["${var.server_name}:latest"]
  }

  triggers = {
    dir_sha1 = sha1(join("", [for f in fileset("${path.module}/docker", "*") : filesha1("${path.module}/docker/${f}")]))
  }
}

# The server (container) itself
resource "docker_container" "server" {
  name     = var.server_name
  image    = docker_image.server.image_id
  must_run = true

  env = ["SSH_PUBLIC_KEY=${trimspace(tls_private_key.ssh.public_key_openssh)}"]

  ports {
    internal = 22
    external = var.ssh_port
  }

  ports {
    internal = 80
    external = var.http_port
  }
}

# Ansible inventory generated from Terraform values
resource "local_file" "inventory" {
  filename = "${path.module}/../ansible/inventory.ini"
  content = templatefile("${path.module}/inventory.tftpl", {
    server_name = var.server_name
    ssh_port    = var.ssh_port
    key_path    = abspath("${path.module}/../ansible/.ssh/id_ed25519")
  })

  depends_on = [docker_container.server]
}
